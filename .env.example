# Public Supabase browser/server client configuration
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME

# Server only. Used strictly for privileged Auth Admin operations such as inviting employees.
# Never expose this variable with NEXT_PUBLIC_ and never use it in Client Components.
SUPABASE_SERVICE_ROLE_KEY=sb_secret_REPLACE_ME

# Canonical application URL used in redirects/emails.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# IANA timezone used for presentation and monthly season labels. DB timestamps stay in UTC.
NEXT_PUBLIC_APP_TIMEZONE=America/Sao_Paulo

# Required only by `npm run seed`, and only against a development project.
# SEED_CONFIRM=DEVELOPMENT_ONLY
